{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShotEye",
  "version": "0.1.0",
  "identifier": "com.moltbagus.shoteye.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:selector",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShotEye",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["native/ShotEyeSelector"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
